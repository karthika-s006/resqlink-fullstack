PORT=5000
# For Atlas, replace every placeholder with values from MongoDB Atlas > Connect > Drivers.
MONGODB_URI=mongodb+srv://karthika:<URL_ENCODED_PASSWORD>@<YOUR_ATLAS_CLUSTER_HOST>/<DATABASE>?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Configure these only when creating the first administrator account.
ADMIN_NAME=replace-with-administrator-name
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=000-000-0000
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters